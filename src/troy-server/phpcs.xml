<?xml version="1.0"?>
<ruleset name="Troy-Server">
	<description>The coding standard used for the Troy Server plugin for WordPress.</description>

	<rule ref="../../phpcs.xml"/>

	<rule ref="TSF.Performance.Opcodes">
		<properties>
			<property name="userNoopChecks" type="array" value=""/>
		</properties>
	</rule>

	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
		<properties>
			<property name="ignoreUnusedRegexp" type="string" value="/network_wide/"/>
			<property name="validUndefinedVariableRegexp" type="string" value="/network_wide/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="troy-server,default"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions">
		<!-- We prefer using constants; don't bother us with unparsable errors. -->
		<exclude name="WordPress.NamingConventions.ValidPostTypeSlug.NotStringLiteral"/>
	</rule>
</ruleset>
