{
	"name": "sybrew/troy-server",
	"description": "Troy Server allows you to distribute WordPress plugins from your independent update repository.",
	"keywords": [
		"wordpress",
		"plugin",
		"distribution",
		"updates",
		"repository"
	],
	"type": "wordpress-plugin",
	"license": "MIT",
	"homepage": "https://deploytroy.org/docs/troy-server/",
	"authors": [
		{
			"name": "Sybre Waaijer",
			"email": "sybrew@users.noreply.github.com",
			"homepage": "https://cyberwire.nl/",
			"role": "Developer"
		}
	],
	"require": {
		"php": "^8.4",
		"composer/installers": "^1.0 || ^2.0",
		"sybrew/troy-client": "^1.0"
	},
	"support": {
		"docs": "https://deploytroy.org/docs/troy-server/",
		"forum": "https://github.com/sybrew/troy/discussions",
		"source": "https://github.com/sybrew/troy/"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
