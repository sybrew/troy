<?xml version="1.0"?>
<ruleset name="Troy-Client">
	<description>The coding standard used for the Troy Client plugin for WordPress.</description>

	<rule ref="../../phpcs.xml"/>

	<rule ref="TSF.Performance.Opcodes">
		<properties>
			<property name="userNoopChecks" type="array" value="get_plugin_slug,get_site_unique_id,get_troy_plugin_dependencies,get_troy_plugin_slugs_per_repo,get_troy_plugin_repos_per_slug,get_troy_plugins,has_troy_plugins,make_fully_qualified_repo_url,make_troy_api_request,make_troy_api_request_cached"/>
		</properties>
	</rule>

	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
		<properties>
			<property name="ignoreUnusedRegexp" type="string" value="/network_wide/"/>
			<property name="validUndefinedVariableRegexp" type="string" value="/network_wide/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="troy-client,default"/>
		</properties>
	</rule>
</ruleset>
